<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".PokerunApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pokerun">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Pokerun">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          F0-T07: a política de privacidade do Health Connect (docs/05 §4.4).

          São duas declarações porque o Health Connect mudou de casa no Android 14.
          Até o 13 ele é um APK e pergunta pela ação abaixo. Do 14 em diante ele é
          parte da plataforma e pergunta pelo alias, que exige a categoria
          HEALTH_PERMISSIONS e a permissão START_VIEW_PERMISSION_USAGE, para que só
          o sistema consiga disparar. Declarar só uma cobre metade dos aparelhos do
          grupo, e a metade descoberta não recebe permissão nenhuma.

          A ficha da tarefa chama a ação antiga de
          `androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE`. Esse nome não
          existe: a ação publicada pela plataforma é a de baixo. Levado ao humano.
        -->
        <activity
            android:name=".PoliticaDePrivacidadeActivity"
            android:exported="true"
            android:label="@string/politica_rotulo"
            android:theme="@style/Theme.Pokerun">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:label="@string/politica_rotulo"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".PoliticaDePrivacidadeActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>