<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema claro fixo. Sem values-night: o app não segue o tema do sistema.

         Os dois atributos acima do minSdk 26 levam tools:targetApi, e não uma cópia do tema
         em values-v27 e values-v29: a API que não conhece o atributo o ignora, e três cópias
         do mesmo tema divergiriam na primeira mudança. Sem a marcação, lintDebug reprova
         com NewApi. -->
    <style name="Theme.Pokerun" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Impede o force-dark do SO (API 29+) de inverter o app. -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>

        <!-- A janela abre já no branco de `fundo`, o mesmo que o Compose desenha: sem
             isto o cold start pinta o fundo do framework antes do primeiro quadro. -->
        <item name="android:windowBackground">@color/fundo</item>

        <!-- Reforça no XML o que enableEdgeToEdge faz em MainActivity, para o intervalo
             entre a janela abrir e o Compose compor. windowLightNavigationBar é API 27:
             em 26 o atributo é ignorado, e a barra fica escura por um quadro. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!--
      Tema de partida da MainActivity: a splash do sistema (docs/02 §2.7). Fundo `fundo` e a
      Pokébola-cronômetro parada: é a fase 1 da abertura, enquanto o app carrega. O clique do
      cronômetro toca em Compose, na fase 2, com a primeira tela pronta.
      installSplashScreen() troca para Theme.Pokerun antes do primeiro quadro do Compose.
    -->
    <style name="Theme.Pokerun.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fundo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icone</item>
        <item name="postSplashScreenTheme">@style/Theme.Pokerun</item>
    </style>
</resources>
